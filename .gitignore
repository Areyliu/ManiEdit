# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and packaging artifacts
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Experiment outputs and logs
/results/**
!/results/**/
!/results/**/.gitkeep
*.log

# Benchmark datasets and cached statistics (download separately; see README)
/data/**
!/data/**/
!/data/**/.gitkeep

# Local editor and operating-system files
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
